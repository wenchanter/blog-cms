# Origin of personal-website, used by the editor's live preview: the preview
# iframe loads <origin>/preview/ and only accepts messages from it.
# Leave empty to fall back to the CMS's built-in approximate preview.
# Inlined at build time, so rebuild after changing it.
# Example: http://localhost:3001 (local) / https://harrison.tech (production)
NEXT_PUBLIC_SITE_ORIGIN=

# Absolute base URL for uploaded images in the /api/posts feed. Defaults to the
# request origin; set it only when the R2 bucket is fronted by its own domain.
PUBLIC_ASSET_BASE_URL=
